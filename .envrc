# .envrc -- single source of truth for the CGO environment used to compile
# against the QuasarDB C API.
#
# This file is loaded by two consumers:
#   1. direnv on developer machines (loaded automatically on cd into repo).
#   2. scripts/cicd/00.common.sh::cicd_setup_qdb_env, which sources this file
#      from inside a bash function so the same variables reach the CI shell.
#
# Per-OS variable matrix:
#   Linux           -> LD_LIBRARY_PATH + CGO_CFLAGS + CGO_LDFLAGS (static libqdb_api)
#   FreeBSD         -> LD_LIBRARY_PATH + CGO_CFLAGS + CGO_LDFLAGS
#   Darwin          -> DYLD_LIBRARY_PATH + CGO_CFLAGS + CGO_LDFLAGS
#   MINGW*          -> PATH (prepend qdb/lib and qdb/bin) + CGO_CFLAGS + CGO_LDFLAGS
#
# Why ${BASH_SOURCE[0]} instead of ${PWD}:
#   Under direnv the two are equivalent, but CI scripts cd into other
#   directories before (or after) sourcing this file. BASH_SOURCE[0]
#   resolves the repo root relative to the file itself, not the caller's
#   working directory, making the exports correct regardless of invocation
#   context.
#
# Plain-bash requirement:
#   This file MUST remain valid input for a bare `source .envrc` from any
#   bash shell. Do NOT use direnv stdlib functions (use, dotenv, source_up,
#   layout, etc.) -- they are unavailable in CI and would abort the source.

# Resolve repo root relative to this file, not the caller's PWD.
_QDB_REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Unconditional QuasarDB path exports used by both CGO compilation and the
# per-OS loader-path setup below.
export QDB_API_DIR="${_QDB_REPO_ROOT}/qdb"
export QDB_LIB_DIR="${QDB_API_DIR}/lib"
export QDB_INCLUDE_DIR="${QDB_API_DIR}/include"

# Set the OS-appropriate dynamic-library search path and CGO compiler/linker
# flags. All Unix-like platforms (Linux, FreeBSD, Darwin) export CGO_CFLAGS
# and CGO_LDFLAGS so cgo can locate the QuasarDB headers and library.
#
# Linux links libqdb_api statically. The Linux c-api package ships a
# self-contained lib/libqdb_api.a next to libqdb_api.so (quasardb
# QDB-19063), so the connector binary carries the C API and needs neither a
# co-located runtime library nor an rpath:
#   - -Bstatic ... -Bdynamic makes -lqdb_api resolve to the archive although
#     the .so sits in the same directory, and links the C++ runtime the
#     archive needs statically as well (-static-libgcc for libgcc); this
#     mirrors quasardb's own -static-libstdc++ -static-libgcc policy, so the
#     binary keeps the .so's portability across glibc-based distributions.
#   - The archive's remaining system dependencies (libm, libdl, libpthread,
#     librt: separate libraries before glibc 2.34) follow it explicitly.
#   - The vendored qdb-api-go carries its own `#cgo LDFLAGS: -lqdb_api`,
#     which cgo appends after CGO_LDFLAGS and which resolves to the .so.
#     Every symbol is already satisfied by the archive at that point, so
#     --as-needed keeps that second resolution from recording a DT_NEEDED
#     entry on libqdb_api.so. scripts/cicd/20.build.sh verifies the result.
#   - -DQDB_API_STATIC_LINK declares the linkage to qdb/_attr.h.
#   LD_LIBRARY_PATH stays: qdbsh and the other CGO tools in the utils
#   package still load libqdb_api.so at runtime.
#
# The other Unix platforms link the shared library and bake two rpath
# entries into every binary:
#   1. The absolute ${QDB_LIB_DIR} path, so dev/test binaries run from the
#      repo checkout without loader-path env vars.
#   2. $ORIGIN (FreeBSD) / @loader_path (Darwin), so a packaged binary
#      finds a libqdb_api co-located in its own directory -- this is what
#      makes the release archive relocatable (see scripts/cicd/20.build.sh).
#      $ORIGIN is backslash-escaped so the literal string reaches the linker;
#      Go passes CGO_LDFLAGS tokens via exec, no shell expansion happens.
case "$(uname)" in
    Linux)
        export LD_LIBRARY_PATH="${QDB_LIB_DIR}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
        export CGO_CFLAGS="${CGO_CFLAGS:+${CGO_CFLAGS} }-I${QDB_INCLUDE_DIR} -DQDB_API_STATIC_LINK"
        export CGO_LDFLAGS="${CGO_LDFLAGS:+${CGO_LDFLAGS} }-L${QDB_LIB_DIR} -Wl,--as-needed -Wl,-Bstatic -lqdb_api -lstdc++ -Wl,-Bdynamic -static-libgcc -lm -ldl -lpthread -lrt"
        ;;
    FreeBSD)
        export LD_LIBRARY_PATH="${QDB_LIB_DIR}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
        export CGO_CFLAGS="${CGO_CFLAGS:+${CGO_CFLAGS} }-I${QDB_INCLUDE_DIR}"
        export CGO_LDFLAGS="${CGO_LDFLAGS:+${CGO_LDFLAGS} }-L${QDB_LIB_DIR} -Wl,-rpath -Wl,${QDB_LIB_DIR} -Wl,-rpath -Wl,\$ORIGIN"
        ;;
    Darwin)
        export DYLD_LIBRARY_PATH="${QDB_LIB_DIR}${DYLD_LIBRARY_PATH:+:${DYLD_LIBRARY_PATH}}"
        export CGO_CFLAGS="${CGO_CFLAGS:+${CGO_CFLAGS} }-I${QDB_INCLUDE_DIR}"
        export CGO_LDFLAGS="${CGO_LDFLAGS:+${CGO_LDFLAGS} }-L${QDB_LIB_DIR} -Wl,-rpath -Wl,${QDB_LIB_DIR} -Wl,-rpath -Wl,@loader_path"
        ;;
    MINGW*)
        # /c/mingw64/bin maps to native C:\mingw64\bin where gcc.exe lives on
        # the Buildkite Windows agent.  MSYS-internal /mingw64/bin (without the
        # `c/` drive prefix) does NOT resolve there.  Without this prepend, Go's
        # cgo subprocess cannot find gcc at startup and silently disables cgo,
        # producing "undefined: Encryption" / "undefined: Compression" errors
        # at compile time because every `import "C"` file is excluded.
        # Mirrors qdb-api-go/scripts/teamcity/common.sh and qdb-api-rest/scripts/common.sh.
        export PATH="/c/mingw64/bin:${QDB_LIB_DIR}:${QDB_API_DIR}/bin:${PATH}"
        # CGO env injection is required on Windows: the vendored library_link.go
        # resolves ${SRCDIR} to the vendored path, where qdb/ does not exist.
        # Unlike Linux/Darwin, we must also supply -lqdb_api explicitly because
        # the source-baked -L${SRCDIR}/qdb/lib is a dead path in the vendor tree.
        export CGO_CFLAGS="${CGO_CFLAGS:+${CGO_CFLAGS} }-I${QDB_INCLUDE_DIR}"
        export CGO_LDFLAGS="${CGO_LDFLAGS:+${CGO_LDFLAGS} }-L${QDB_LIB_DIR} -L${QDB_API_DIR}/bin -lqdb_api"
        ;;
    *)
        echo ".envrc: unknown OS '$(uname)'" >&2
        return 1
        ;;
esac

unset _QDB_REPO_ROOT
